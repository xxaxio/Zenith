# systemd unit for Zenith (High-Performance Zero-Chunk Virtual Limbo & Defense Daemon)
# Install as /etc/systemd/system/zenith.service
#
#   ExecStart       Points to the binary and configuration file path.
#   ExecReload      Sends SIGHUP (kill -HUP): hot-reloads configuration without dropping sessions.
#   TimeoutStopSec  Grace period for active virtual session drains before SIGKILL.
#   LimitNOFILE     Sets high-density socket descriptors (1,048,576) to sustain high-concurrency swarms.

[Unit]
Description=Zenith Zero-Chunk Virtual Limbo & Cyber-Defense Daemon
Documentation=https://github.com/xxaxio/Zenith
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zenith
Group=zenith
ExecStart=/usr/local/bin/zenith /etc/zenith/zenith.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

# Socket & File Descriptor Capacity (Supports 1M+ active connections)
LimitNOFILE=1048576

# Hardened Linux Security Sandbox
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

# Required read access to config directory
ReadOnlyPaths=/etc/zenith

[Install]
WantedBy=multi-user.target
